# Copy this file to .env.local for local development.
# Real secrets belong only in .env.local or your deployment's secret store. Never commit them.
# Easiest: run `pnpm onboard`, which writes this file for you.
# Check what the scout will use with: pnpm scout:doctor

# Mock mode runs the whole pipeline with sample data and no API keys.
MOCK_MODE=true

# --- Preferences -------------------------------------------------------------
# Which scout profile to use: a preset name from profiles/ or a path to a YAML file.
# If unset, the scout uses ./scout.profile.yaml when it exists, else the built-in
# consumer-ai-founder profile. See docs/profiles.md.
SCOUT_PROFILE=

# --- LLM provider ------------------------------------------------------------
# Pick one: openai, anthropic, gemini, deepseek, dashscope, dashscope-intl,
# openrouter, ollama, openai-compatible. Required for real scans (mock mode works without one).
# See docs/llm-providers.md for defaults and examples.
LLM_PROVIDER=
# Your key for that provider. Provider-specific names also work
# (OPENAI_API_KEY, ANTHROPIC_API_KEY, GEMINI_API_KEY, DEEPSEEK_API_KEY, DASHSCOPE_API_KEY, OPENROUTER_API_KEY).
LLM_API_KEY=
# Optional overrides. LLM_MODEL sets all three tasks; the specific ones win over it.
LLM_MODEL=
LLM_EXTRACT_MODEL=
LLM_SCORE_MODEL=
LLM_FAST_MODEL=
# Required for openai-compatible (e.g. a vLLM, LM Studio, Groq, Together, or Moonshot endpoint).
LLM_BASE_URL=
# Optional: chat | responses | anthropic (normally implied by the provider).
LLM_API_STYLE=
# Optional: request JSON mode (response_format json_object) on providers that support it.
LLM_JSON_MODE=false
# Optional: reasoning effort. Anthropic defaults to low; other providers only send it when set.
LLM_REASONING_EFFORT=
# Optional: max output tokens (Anthropic defaults to 16000).
LLM_MAX_TOKENS=
# Optional: JSON merged into chat/responses request bodies, e.g. {"temperature":0.2}
LLM_EXTRA_BODY=

# --- Discovery ---------------------------------------------------------------
EXA_API_KEY=
X_BEARER_TOKEN=
FIRECRAWL_API_KEY=

# --- Storage, scheduling, notifications --------------------------------------
# Postgres for hosted deployments. Without it, real runs are saved to .scout-data/ (or SCOUT_DATA_DIR).
DATABASE_URL=
SCOUT_DATA_DIR=

TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

APP_BASE_URL=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_PORT=4310

# --- Budget ------------------------------------------------------------------
# How much one scan may spend: small (about $0.25 a scan), medium (about $0.50), or large
# (about $1, plus X). Unset means large. docs/setup-and-costs.md has the details.
SCOUT_BUDGET=small

# Fine-tuning: leave these empty to take SCOUT_BUDGET's value; a number here wins over it.
MAX_EXA_SEARCHES_PER_RUN=
MAX_X_POSTS_PER_DAY=
MAX_X_POSTS_PER_RUN=
MAX_FIRECRAWL_PAGES_PER_RUN=
MAX_LLM_EXTRACT_CANDIDATES_PER_RUN=
MAX_LLM_SCORE_EVENTS_PER_RUN=
# Pages read and events scored at the same time (default 4, at most 6). Lower them to 1 if a free
# LLM tier keeps rate-limiting you.
MAX_LLM_EXTRACT_CONCURRENCY=
MAX_LLM_SCORE_CONCURRENCY=
MAX_AGENT_GENERATED_EXA_QUERIES=
MAX_AGENT_GENERATED_X_QUERIES=0
MAX_EXPLORATION_BUDGET_PERCENT=50
MAX_RECOMMENDATIONS_PER_RUN=10

# --- Schedules ----------------------------------------------------------------
# Scan times (Pacific) used by the Trigger.dev schedules; a time left out of SCAN_SCHEDULES is
# skipped. X is only searched on the X_SCAN_SCHEDULES scans.
SCAN_SCHEDULES=09:00,14:00,22:00
X_SCAN_SCHEDULES=09:00

# Logs: readable in a terminal, JSON elsewhere. Override with pretty or json; LOG_LEVEL=debug for more detail.
LOG_FORMAT=
LOG_LEVEL=

EXA_TIMEOUT_MS=20000
X_TIMEOUT_MS=20000
FIRECRAWL_TIMEOUT_MS=20000
PAGE_FETCH_TIMEOUT_MS=15000
LLM_TIMEOUT_MS=45000
TELEGRAM_TIMEOUT_MS=15000
POSTGRES_CONNECTION_TIMEOUT_MS=10000
POSTGRES_QUERY_TIMEOUT_MS=30000
